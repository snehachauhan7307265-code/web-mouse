# WebMouse V1 — Environment Variables Configuration
# This frontend is deployed as a static Single Page Application (e.g. on Vercel).
# All connections to your local Windows Helper are initiated directly from the user's browser.

# Optional: Default WebSocket URL of the Windows Helper
# Example: ws://192.168.1.5:8765
VITE_WEBSOCKET_URL=

# Or specify default host and port separately:
# VITE_DEFAULT_HELPER_HOST=192.168.1.5
# VITE_DEFAULT_HELPER_PORT=8765
